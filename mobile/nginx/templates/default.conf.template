# Static Flutter web build (unprivileged nginx on 8080). TLS, rate limits and /api routing live in
# the load balancer / ingress in front of this container.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json application/wasm image/svg+xml;
    gzip_min_length 1024;

    # Entry points change with every release: always revalidate (the ETag turns it into a 304).
    location ~ ^/(index\.html|flutter_bootstrap\.js|flutter_service_worker\.js|main\.dart\.(js|wasm|mjs)|version\.json|manifest\.json)$ {
        include /etc/nginx/conf.d/snippets/headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # Engine, fonts and images: cacheable for a day.
    location ~ ^/(canvaskit|assets|icons)/ {
        include /etc/nginx/conf.d/snippets/headers.conf;
        add_header Cache-Control "public, max-age=86400" always;
        try_files $uri =404;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Clean URLs (/booking/AB12CD, /payment-result?...) are app routes.
    location / {
        include /etc/nginx/conf.d/snippets/headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
